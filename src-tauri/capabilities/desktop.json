{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "What the desktop page, served by the app's own server, is allowed to call: what a page cannot do itself",
  "platforms": ["linux", "macOS", "windows"],
  "windows": ["main"],
  "remote": { "urls": ["http://127.0.0.1:*"] },
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "allow-ui-scale",
    "allow-set-ui-scale",
    "allow-app-logs",
    "allow-set-caption-buttons",
    "allow-display-is-hdr",
    "allow-pick-export-folder",
    "allow-export-to-folder",
    "allow-open-original-with",
    "allow-open-folder",
    "allow-reveal-file",
    "allow-reveal-original",
    "allow-app-data-dir",
    "allow-open-app-data-dir"
  ]
}
