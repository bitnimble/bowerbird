{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "default",
  "description": "What the mobile page, served by the app's own server, is allowed to call: what a page cannot do itself",
  "platforms": ["android", "iOS"],
  "windows": ["main"],
  "remote": { "urls": ["http://127.0.0.1:*"] },
  "permissions": [
    "core:default",
    "allow-set-ui-scale",
    "allow-app-logs",
    "allow-server-log-file",
    "allow-read-device-file",
    "allow-write-device-file",
    "allow-display-range",
    "allow-pick-export-folder",
    "allow-photo-access",
    "allow-ask-photo-access",
    "allow-app-data-dir",
    "allow-stage-warm",
    "allow-stage-reset",
    "allow-stage-prepare",
    "allow-stage-release",
    "allow-stage-show",
    "allow-stage-hide"
  ]
}
