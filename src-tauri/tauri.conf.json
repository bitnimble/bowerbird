{
  "$schema": "../web/node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Bowerbird",
  "identifier": "dev.kumo.bowerbird",
  "build": {
    "frontendDist": ["placeholder.html"],
    "beforeBuildCommand": "bun run --cwd web build"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Bowerbird",
        "create": false,
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 14, "y": 23 }
      }
    ],
    "security": {
      "csp": null,
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "require-corp"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "app", "dmg", "nsis"],
    "icon": ["icons/icon.png"],
    "externalBin": ["binaries/bowerbird-server"],
    "resources": { "resources": "resources", "../web/dist": "web" },
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": false
    }
  }
}
