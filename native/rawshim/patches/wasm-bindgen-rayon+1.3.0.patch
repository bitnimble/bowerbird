+// Droppable stand-in for Rayon's build_global(): stock wasm-bindgen-rayon installs a
+// process-global pool that never exits, so Worker.terminate() on leave-edit can leave
+// waiters spinning (reproduced as a Mac Chrome CPU peg). Holding a ThreadPool and
+// dropping it on exitThreadPool lets workers leave main_loop cooperatively.
+static POOL: Mutex<Option<Arc<ThreadPool>>> = Mutex::new(None);
+
+/// Run `f` on the pool built by `initThreadPool`. Parallel iterators inside `f` use this
+/// pool; outside it they would hit Rayon's unset global and try to spawn native threads.
+pub fn with_thread_pool<R: Send>(f: impl FnOnce() -> R + Send) -> R {
+    let pool = {
+        let guard = POOL.lock().unwrap_throw();
+        Arc::clone(guard.as_ref().expect_throw(
+            "rayon thread pool used before initThreadPool or after exitThreadPool",
+        ))
+    };
+    pool.install(f)
+}
+
+/// Number of workers in the droppable pool, or 1 if it is not up yet.
+pub fn pool_num_threads() -> usize {
+    POOL.lock()
+        .ok()
+        .and_then(|guard| guard.as_ref().map(|pool| pool.current_num_threads()))
+        .unwrap_or(1)
+}
+
+/// Drop the pool so worker threads leave Rayon's main loop. Call from the editor worker
+/// before terminating document-owned pool workers.
+#[wasm_bindgen(js_name = exitThreadPool)]
+pub fn exit_thread_pool() {
+    let _ = POOL.lock().unwrap_throw().take();
+}
