# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc test coverage
.nyc_output

# Grunt intermediate storage (https://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/
jspm_packages/

# Snowpack dependency directory (https://snowpack.dev/)
web_modules/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variable files
.env
.env.*
!.env.example

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# Next.js build output
.next
out

# Nuxt.js build / generate output
.nuxt
dist

# Gatsby files
.cache/
# Comment in the public line in if your project uses Gatsby and not Next.js
# https://nextjs.org/blog/next-9-1#public-directory-support
# public

# vuepress build output
.vuepress/dist

# vuepress v2.x temp and cache directory
.temp
.cache

# Sveltekit cache directory
.svelte-kit/

# vitepress build output
**/.vitepress/dist

# vitepress cache directory
**/.vitepress/cache

# Docusaurus cache and generated files
.docusaurus

# Serverless directories
.serverless/

# FuseBox cache
.fusebox/

# DynamoDB Local files
.dynamodb/

# Firebase cache directory
.firebase/

# TernJS port file
.tern-port

# Stores VSCode versions used for testing VSCode extensions
.vscode-test

# yarn v3
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Vite logs files
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Bowerbird
/photos/
/.photos/
# The frames e2e renders once per checkout, from the crate rather than from a camera.
/test/fixtures/pano-views/
/test/fixtures/merge-burst/
bowerbird.db
bowerbird.db-*
# The catalogue a restore moves aside (§4.9), which is `.db.` rather than `.db-`.
bowerbird.db.*
# DATA_DIR's default, i.e. every generated file when the app runs from a checkout.
/data/
# Backups are taken beside the catalogue (§4.9), so running from a checkout puts
# them here - and the first one lands on the first start, not a week later.
/backups/

# Playwright / E2E
test-results/
web/test-results/
web/playwright-report/
.playwright-mcp/

# Screenshots taken while driving the app
*.png
*.jpg
!landing/public/shots/*.jpg
!test/fixtures/snapshots/**/*.png

# A GPU test that panics segfaults on teardown, and the dump lands wherever it ran,
# at half a gigabyte. `git add -A` sweeps one into a commit before anyone reads the
# diff stat.
core.[0-9]*

# Rust native module build output (native/rawshim). The .so is built by
# `bun run build:native`, or by the Docker build stage.
native/rawshim/target/
# The supervisor's, built by the Docker build stage and by `cargo build` inside the
# desktop shell, which links the same crate.
native/launcher/target/
# The lens database's, which only its own suite builds as a root.
native/lensdb/target/
# The HEIF reader's and the browser's AV1 decoder's, likewise.
native/heif/target/
native/avif_planes/target/
# Materialised by ensure-patched-rayon.sh from patches/; not committed.
native/rawshim/patched/
# Where `bun run build:wasm` puts wasm-pack's output, which the editor imports as a
# module (`local_open.ts`) and Vite's `fs.allow` reaches outside its root for.
native/rawshim/pkg/
# The pinned toolchains and libraries. Each is a symlink into `~/.cache/bowerbird`, so no trailing
# slash: these are files here, and a directory pattern would not match them.
# `bun run get:slangc`, a toolchain rather than a source.
native/rawshim/.slangc
# `bun run get:codecs`.
native/rawshim/.codecs
# `bun run get:swiftshader`, wanted only on a machine with no GPU.
native/rawshim/.swiftshader
# PMRID's published weights, unpacked by `bun run get:pmrid` for the prototype that reads them.
native/rawshim/.pmrid

# Throwaway analysis scripts. `.oxlintrc.json` already ignores the .ts ones;
# this keeps them out of commits, which a squash otherwise sweeps them into.
.scratch-*

# Rendered records used to hold one pipeline against another. Regenerable, and
# large: `examples/baseline.rs` writes them.
.baseline/
OVERNIGHT_LOG.md

# What the desktop app carries: the Bun runtime, the bundled server and the native
# library with everything it opens. All of it is built by `bun run build:sidecar`, and
# the runtime alone is around a hundred megabytes.
src-tauri/binaries/
src-tauri/resources/

