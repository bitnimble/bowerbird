{
  "worktree": {
    "setup": [
      "[ ! -f $PASEO_SOURCE_CHECKOUT_PATH/.env ] || cp $PASEO_SOURCE_CHECKOUT_PATH/.env $PASEO_WORKTREE_PATH/",
      "[ ! -f $PASEO_SOURCE_CHECKOUT_PATH/web/.env ] || cp $PASEO_SOURCE_CHECKOUT_PATH/web/.env $PASEO_WORKTREE_PATH/web/",
      "scripts/subwt.sh",
      "bun install",
      "bun run get:all",
      "bun run build:native",
      "cd web && bun install"
    ]
  },
  "scripts": {
    "release": {
      "command": "bun run release"
    }
  }
}
