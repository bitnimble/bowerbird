# Copy to .env and adjust.

# REQUIRED for docker-compose.dev.yml only: this repo's absolute path ON THE
# DOCKER HOST (the dev container live-mounts it). This differs from the repo path
# inside your editing environment, so it must be set explicitly.
# REPO_DIR=/path/to/bowerbird/on/docker/host

# Host directory holding your RAW photos, bind-mounted to /photos in the container.
PHOTOS_DIR=./photos

# Host port to publish the API on (container always listens on 3000).
HOST_PORT=3000

# API listen port when running outside Docker. Unset picks a free port at random
# (printed on startup) so parallel checkouts don't collide; `-p <port>` wins over it.
# PORT=3000

# debug | info | warn | error. debug adds a line per HTTP request (DESIGN §14.3).
LOG_LEVEL=info

# Filesystem watching: auto-sync a library when its files change on disk.
WATCH_ENABLED=true
WATCH_DEBOUNCE_MS=2000
# Daily full reconcile, local HH:MM: backstop for changes the watcher missed.
# Holds the library lock while it scans, so pick a quiet hour. "" disables.
SYNC_FULL_AT=03:00

# Rendition worker pool + AVIF output tuning (DESIGN §15).
PROCESSING_CONCURRENCY=4
GRID_RENDITION_SIZE=800
FULL_RENDITION_SIZE=3840
GRID_RENDITION_QUALITY=80
FULL_RENDITION_QUALITY=90
