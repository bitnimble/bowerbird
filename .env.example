# Copy to .env and adjust. All values are optional (defaults shown).

# Host directory holding your RAW photos, bind-mounted to /photos in the container.
PHOTOS_DIR=./photos

# Host port to publish the API on (container always listens on 3000).
HOST_PORT=3000

# Thumbnail worker pool + WebP output tuning (DESIGN §15).
PROCESSING_CONCURRENCY=4
SMALL_THUMBNAIL_SIZE=800
FULL_THUMBNAIL_SIZE=3840
SMALL_THUMBNAIL_QUALITY=80
FULL_THUMBNAIL_QUALITY=90
