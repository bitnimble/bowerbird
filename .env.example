# Copy to .env and adjust.
#
# Only what has to be known before the catalogue can be opened lives here, plus the
# one thing that depends on the host's own /etc/group. Everything else - the worker
# pool, rendition sizes and qualities, HDR grading, watching, the scheduled jobs, the
# log level - is a setting on the app's Settings page, stored in the database
# (DESIGN §15).

# REQUIRED for docker-compose.dev.yml only: this repo's absolute path ON THE
# DOCKER HOST (the dev container live-mounts it). This differs from the repo path
# inside your editing environment, so it must be set explicitly.
# REPO_DIR=/path/to/bowerbird/on/docker/host

# REQUIRED for docker-compose.dev.yml only, and both are paths on the DOCKER HOST,
# as REPO_DIR is. Production keeps the pair in named volumes.
#
# The catalogue and its backups, bind-mounted to /config. This is the one that must
# survive: /data below is a cache and can be deleted at any time.
# CONFIG_DIR_HOST=/path/to/bowerbird-config/on/docker/host
#
# Renditions and camera matches, bind-mounted to /data.
# DATA_DIR_HOST=/path/to/bowerbird-data/on/docker/host

# docker-compose.yml only: which published image to run. A branch name, a version
# (1.2.3, 1.2), or a commit as sha-<short>; `latest` is main's most recent build.
# BOWERBIRD_TAG=latest

# Host directory holding your RAW photos, bind-mounted to /photos in the container.
PHOTOS_DIR=./photos

# docker-compose.yml only: what to mount at /data, holding renditions and camera
# matches. A named volume by default, and a host path is the reason to set it -
# which then has to be chowned to uid 1000, as a named volume does not.
# DATA_VOLUME=/mnt/bulk/bowerbird-data

# docker-compose.dev.yml only: comma-separated domains the web dev server answers
# to when it is served behind one.
# VITE_ALLOWED_HOSTS=photos.example.com

# Host port to publish the API on (container always listens on 3000).
# docker-compose.yml only: the dev stack publishes just the web server, and
# reaches the API through its proxy.
HOST_PORT=3000

# docker-compose.dev.yml only: host port for the web dev server, which is the
# only thing that stack publishes.
# WEB_PORT=5173

# The host's `render` group, which is what lets the container open /dev/dri and use
# the GPU. Both compose files default to 106 (Debian, Ubuntu); other distributions
# differ, so check with:
#
#   getent group render | cut -d: -f3
#
# Getting it wrong is not an error. The image carries a CPU rasteriser, so the app
# renders anyway - several times slower, and the only sign is the `gpu:` line it
# prints at startup naming `SwiftShader` instead of your card.
# RENDER_GID=106

# docker-compose.dev.yml only: `nvidia` on a host with an NVIDIA card and
# nvidia-container-toolkit, which is what hands the container the card's driver. The
# default `runc` reaches only what `devices:` names, so an NVIDIA box left on it renders
# on whatever else answers - the integrated AMD or Intel part, or SwiftShader - and says so
# in the same `gpu:` line RENDER_GID above describes.
# NVIDIA_RUNTIME=nvidia

# Container timezone, an IANA name (Australia/Sydney, Europe/London). Both compose
# files default to UTC; the image carries tzdata, so nothing needs mounting.
# TZ=UTC

# API listen port when running outside Docker. Unset picks a free port at random
# (printed on startup) so parallel checkouts don't collide; `-p <port>` wins over it.
# PORT=3000
