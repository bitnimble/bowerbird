{
  "name": "bowerbird",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun run dev.ts",
    "restore": "bun run scripts/restore-backup.ts",
    "dev:docker": "bun run build:native && docker rm -f bowerbird-dev bowerbird-web-dev; docker compose -f docker-compose.dev.yml up --build",
    "lint": "oxlint",
    "test": "LOG_LEVEL=warn DATA_DIR=${TMPDIR:-/tmp}/bowerbird-test-data bun test src",
    "test:integration": "LOG_LEVEL=warn DATA_DIR=${TMPDIR:-/tmp}/bowerbird-test-data bun test test/integration",
    "test:native": "bun run scripts/cargo.ts test --profile quick --tests --manifest-path native/rawshim/Cargo.toml",
    "test:native:full": "bun run scripts/cargo.ts test --profile quick --tests --manifest-path native/rawshim/Cargo.toml --features fixtures",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e-tauri/tsconfig.json",
    "build:native": "bun run scripts/cargo.ts build --profile quick --manifest-path native/rawshim/Cargo.toml",
    "build:native:release": "bun run scripts/cargo.ts build --release --manifest-path native/rawshim/Cargo.toml",
    "build:wasm": "wasm-pack build native/rawshim --target web --out-dir pkg -- --no-default-features",
    "e2e:tauri:build": "bun run scripts/build-wdio-app.ts",
    "e2e:tauri": "bun run e2e:tauri:build && bun run scripts/e2e-tauri-full.ts",
    "tauri": "bun x @tauri-apps/cli",
    "mac:build": "bun run scripts/mac-build.ts",
    "win:build": "bun run scripts/win-build.ts",
    "android:build": "bun run scripts/android-build.ts"
  },
  "dependencies": {
    "@parcel/watcher": "^2.6.0",
    "fast-xml-parser": "^5.10.1",
    "hono": "^4.6.14",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/node": "^22.10.0",
    "@wdio/cli": "^9",
    "@wdio/globals": "^9",
    "@wdio/local-runner": "^9",
    "@wdio/mocha-framework": "^9",
    "@wdio/spec-reporter": "^9",
    "@wdio/tauri-plugin": "1.2.0",
    "@wdio/tauri-service": "1.2.0",
    "oxlint": "^1.76.0",
    "typescript": "^5.7.2"
  },
  "patchedDependencies": {
    "@wdio/native-utils@2.4.0": "patches/@wdio%2Fnative-utils@2.4.0.patch"
  }
}
