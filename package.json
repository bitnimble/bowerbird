{
  "name": "bowerbird",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun run dev.ts",
    "dev:docker": "bun run build:native && sudo docker compose -f docker-compose.dev.yml up --build",
    "lint": "oxlint",
    "test": "LOG_LEVEL=warn bun test src",
    "test:integration": "LOG_LEVEL=warn bun test test/integration",
    "test:native": "cargo test --release --manifest-path native/rawshim/Cargo.toml",
    "test:native:full": "cargo test --release --manifest-path native/rawshim/Cargo.toml --features fixtures",
    "typecheck": "tsc --noEmit",
    "build:native": "cargo build --release --manifest-path native/rawshim/Cargo.toml",
    "e2e:tauri:build": "bun run scripts/build-wdio-app.ts",
    "e2e:tauri": "bun run e2e:tauri:build && xvfb-run -a wdio run wdio.conf.ts",
    "tauri": "bun x @tauri-apps/cli",
    "mac:build": "bun run scripts/mac-build.ts"
  },
  "dependencies": {
    "@parcel/watcher": "^2.6.0",
    "hono": "^4.6.14",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/node": "^22.10.0",
    "@wdio/cli": "^9",
    "@wdio/globals": "^9",
    "@wdio/local-runner": "^9",
    "@wdio/mocha-framework": "^9",
    "@wdio/spec-reporter": "^9",
    "@wdio/tauri-plugin": "1.2.0",
    "@wdio/tauri-service": "1.2.0",
    "oxlint": "^1.76.0",
    "typescript": "^5.7.2"
  },
  "patchedDependencies": {
    "@wdio/native-utils@2.4.0": "patches/@wdio%2Fnative-utils@2.4.0.patch"
  }
}
